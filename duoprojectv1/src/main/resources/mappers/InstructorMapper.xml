<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wecompany.duoprojectv1.mapper.InstructorMapper">

    <!-- 강의 목록 조회 (교수 계정 기반) -->
    <select id="findLecturesByInstructor" parameterType="int" resultType="com.wecompany.duoprojectv1.dto.InstructorLectureDto">
    SELECT cos_id, cos_name, price, create_date
    FROM lecture
    WHERE ins_id = #{insId}
</select>



    <!-- 교수의 수강생 목록 조회 -->
    <select id="findEnrolledStudentsByInstructor" parameterType="int" resultType="com.wecompany.duoprojectv1.dto.EnrolledStudentDto">
    SELECT s.st_num, s.st_name, s.st_department, s.st_year, l.cos_name
    FROM enrollment e
    JOIN student s ON e.st_num = s.st_num
    JOIN lecture l ON e.cos_id = l.cos_id
    WHERE l.ins_id = #{insId}
</select>


    <select id="findById" resultType="com.wecompany.duoprojectv1.domain.Instructor">
    SELECT * FROM instructor WHERE ins_id = #{insId}
</select>

    <!-- resources/mappers/InstructorMapper.xml -->


    <select id="findByAccId" resultType="com.wecompany.duoprojectv1.domain.Instructor">
        SELECT * FROM instructor WHERE acc_id = #{accId}
    </select>




</mapper>